# Supabase (02-mimari.md Bölüm 9). Gerçek değerler .env.local içinde; asla commit'lenmez.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                 # sadece sunucu (lib/supabase/admin.ts)
# Öğrenci sentetik e-posta alanı (02 karar #19). Bu adrese e-posta gitmez. Boşsa koddaki varsayılan
# (ogrenci.pusula.local) kullanılır. Bulutta da aynı kalmalı; değişirse mevcut öğrenciler giriş yapamaz.
STUDENT_EMAIL_DOMAIN=ogrenci.pusula.local
YOUTUBE_API_KEY=                     # sadece sunucu, Faz 5
NEXT_PUBLIC_SITE_URL=http://localhost:3000
